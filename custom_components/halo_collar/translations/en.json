  "options": {
    "step": {
      "init": {
        "title": "Halo Collar options",
        "data": {
          "scan_interval": "Update interval (seconds)",
          "stale_after": "Collar report age limit (seconds)",
          "enable_fence_controls": "Enable fail-safe fence controls",
          "enable_find_collar": "Enable Find collar sound and light",
          "allow_fence_disable": "Allow fences to be disabled (requires fence controls)"
        },
        "data_description": {
          "scan_interval": "How often to poll the Halo cloud for new telemetry. Between 60 and 3600 seconds; the collar itself typically reports every few minutes.",
          "stale_after": "Report age after which Connectivity turns off. This reflects the last collar report, not a live connection check. Polling the cloud does not force a collar report. Between 120 and 86400 seconds. Controls always require reports no older than 900 seconds, or this limit if shorter.",
          "enable_fence_controls": "Adds an idempotent Enable fences button. Controls remain unavailable when collar telemetry is stale.",
          "enable_find_collar": "Adds a manual sound and light button. It may confuse a pet wearing the collar. The command is blocked on stale/ambiguous state, active or unknown walks, missing subscription entitlement, and a post-dispatch cooldown; ambiguous outcomes are never retried.",
          "allow_fence_disable": "Also adds a Fence mode switch that can disable containment. This remains off unless fail-safe fence controls are enabled, requires a separate high-risk opt-in, and is blocked during an active walk."
        }
      }
    }
